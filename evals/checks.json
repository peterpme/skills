{
  "already-live": {
    "maxDecisions": 2,
    "mustMatch": ["#42"],
    "mustNotMatch": ["(puts?|goes|go|going|makes?)\\b[^.\\n]{0,30}\\blive", "\\*\\*Done\\*\\*[^*]*live (in|on) production"]
  },
  "ci-balance-delegate": {
    "skill": "delegate",
    "mustMatch": [
      "@solana/(?:web3\\.js|kit)",
      "@actions/core",
      "(?:npm (?:install|i|ci)[^\\n]*\\.github/scripts|working-directory:[ `]*\\.github/scripts[\\s\\S]{0,300}npm (?:install|i|ci)\\b)"
    ],
    "mustNotMatch": []
  },
  "coordinator-cross-project": {
    "skill": "coordinator",
    "mustMatch": [
      "\\bt3_thread_launch\\b",
      "API-27\\s*·",
      "project-api",
      "\\bworkspaceStrategy\\b[\\s\\S]{0,120}\\bworktree\\b"
    ],
    "mustNotMatch": []
  },
  "coordinator-release": {
    "skill": "coordinator",
    "mustMatch": [
      "\\bt3_thread_launch\\b",
      "MOB-42\\s*·",
      "project-mobile",
      "\\bworkspaceStrategy\\b[\\s\\S]{0,120}\\bworktree\\b"
    ],
    "mustNotMatch": []
  },
  "coordinator-small-comment": {
    "skill": "coordinator",
    "mustMatch": [
      "gh issue comment|save_comment|add_comment|comment on (?:the|this) (?:existing )?issue|post .*\\bcomment\\b",
      "no new (?:tickets?|issue)|none|no ticket|tickets?:\\s*0\\b",
      "no (?:new )?(?:worker |visible )?threads?|none|threads?:\\s*0\\b"
    ],
    "mustNotMatch": [
      "\\bt3_thread_launch\\b",
      "\\bdelegate_task\\b"
    ]
  },
  "long-report": {
    "maxDecisions": 4,
    "mustMatch": ["#311", "UTC|time ?zone|Toronto", "nightly|cron", "legacy"],
    "mustNotMatch": []
  },
  "nothing-needed": {
    "maxDecisions": 0,
    "mustMatch": ["Nothing needed from you"],
    "mustNotMatch": ["\\*\\*Decide\\*\\*", "\\*\\*Next\\*\\*"]
  }
}

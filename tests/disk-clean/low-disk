#!/usr/bin/env bash
# Runs bin/disk-clean --apply --only worktrees with a faked free-space reading under the low-disk
# line, in a fake HOME with agent worktrees that were all used just now (so no age rule fires).
# The risks: the low-disk pass deletes something that cannot be rebuilt, deletes under a running
# process, or keeps deleting after free space is back.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
tool=$here/../../bin/disk-clean
work=$(mktemp -d)
trap 'kill "${busy_pid:-}" "${held_pid:-}" 2>/dev/null; rm -rf "$work"' EXIT
export HOME=$work/home DISK_CLEAN_STATE=$work/state GIT_CONFIG_GLOBAL=/dev/null DISK_CLEAN_MIN_GAP_MIN=0 \
  GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t

repo=$HOME/Projects/r
trees=$HOME/.t3/worktrees/r
mkdir -p "$repo/android/build" "$repo/PKG/node_modules/deep" "$trees"
git -C "$repo" init -q -b main
printf 'node_modules/\n.verification/\nandroid/build/\n' >"$repo/.gitignore"
echo a >"$repo/a.txt"
echo '{}' >"$repo/package.json"
echo '{}' >"$repo/PKG/package.json"
echo kept >"$repo/android/build/tracked.txt"        # ignored build output that still holds a tracked file
echo kept >"$repo/PKG/node_modules/deep/tracked.txt" # the same, under a folder whose case changes below
git -C "$repo" add . && git -C "$repo" add -f android/build/tracked.txt PKG/node_modules/deep/tracked.txt
git -C "$repo" commit -qm init

# tree name, megabytes of dependencies
add() {
  local t=$trees/$1
  git -C "$repo" worktree add -q -b "$1" "$t"
  mkdir -p "$t/node_modules/pkg" "$t/.verification/proof"
  head -c $(($2 * 1000000)) /dev/zero >"$t/node_modules/pkg/blob"
  echo log >"$t/.verification/proof/run.log"
  echo new >"$t/notes.txt"          # untracked, not ignored
  mkdir -p "$t/Pods" && echo mine >"$t/Pods/hand-written.txt"   # named like dependencies, but not ignored
  echo edit >>"$t/a.txt"            # tracked edit
}
add big 6
add mid 4
add small 2
add busy 12
add held 10
# In `big`, the folders a careless pass would take first: each is ignored, bigger than its
# dependencies, and holds a tracked file. One was renamed by case only, as a Mac's disk allows.
head -c 9000000 /dev/zero >"$trees/big/android/build/blob"
head -c 8000000 /dev/zero >"$trees/big/PKG/node_modules/deep/blob"
mv "$trees/big/PKG" "$trees/big/renaming" && mv "$trees/big/renaming" "$trees/big/pkg"
# A repository inside a dependency folder holds work, not build output.
mkdir -p "$trees/mid/sub/node_modules/clone" && echo '{}' >"$trees/mid/sub/package.json"
git -C "$trees/mid/sub/node_modules/clone" init -q && head -c 11000000 /dev/zero >"$trees/mid/sub/node_modules/clone/work"
# Dependencies with no package.json beside them: nothing says they can be reinstalled.
mkdir -p "$trees/small/orphan/node_modules" && head -c 7000000 /dev/zero >"$trees/small/orphan/node_modules/blob"

(cd "$trees/busy" && exec sleep 120) &
busy_pid=$!
(cd "$work" && exec sleep 120 <"$trees/held/node_modules/pkg/blob") &   # runs elsewhere, holds a file open
held_pid=$!
sleep 1
before=$(git -C "$trees/big" status --porcelain)

# 10 MB "free", low-disk line at 14 MB, target 15 MB, and each delete frees half its listed size
# (cloned files): 6 MB gives 13, 4 MB more gives 15. A pass that trusted listed sizes would stop at one.
DISK_CLEAN_LOW_MIN_MB=1 DISK_CLEAN_FAKE_FREE=10000000 DISK_CLEAN_FAKE_GAIN=0.5 \
  "$tool" --apply --only worktrees --low-under 14M --free-target 15M >"$work/out" 2>&1
code=$?
after=$(git -C "$trees/big" status --porcelain)

fail=0
check() { # rule path expect(present|gone)
  local actual=gone ok=yes
  [[ -e $2 ]] && actual=present
  [[ $actual == "$3" ]] || { ok=NO; fail=1; }
  printf '%-78s expect %-8s actual %-8s %s\n' "$1" "$3" "$actual" "$ok"
}
echo "the low-disk pass deletes only ignored dependency and build folders; tracked and untracked files stay"
check "  biggest idle tree loses its dependencies" "$trees/big/node_modules" gone
check "  its untracked file stays" "$trees/big/notes.txt" present
check "  its proof log stays" "$trees/big/.verification/proof/run.log" present
check "  an ignored build folder holding a tracked file stays" "$trees/big/android/build/tracked.txt" present
check "  the same under a folder renamed by case only stays" "$trees/big/pkg/node_modules/deep/tracked.txt" present
check "  a folder named Pods that git does not ignore stays" "$trees/big/Pods/hand-written.txt" present
check "  a repository inside a dependency folder stays" "$trees/mid/sub/node_modules/clone/work" present
check "  dependencies with no package.json beside them stay" "$trees/small/orphan/node_modules/blob" present
[[ $before == "$after" ]] && same=yes || { same=NO; fail=1; }
printf '%-78s expect %-8s actual %-8s %s\n' "  git status of that tree is unchanged" same "$([[ $same == yes ]] && echo same || echo changed)" "$same"
echo "a worktree with a process running in it keeps its dependencies"
check "  the biggest folder of all, in the busy tree" "$trees/busy/node_modules" present
check "  a folder with a file held open by a process running elsewhere" "$trees/held/node_modules" present
echo "the low-disk pass stops once free space reaches the target"
check "  second biggest goes too: the first delete freed half its listed size" "$trees/mid/node_modules" gone
check "  smallest keeps its dependencies" "$trees/small/node_modules" present
[[ $code == 0 ]] || { echo "disk-clean exited $code"; fail=1; }
[[ $fail == 0 ]] || sed 's/^/    /' "$work/out"
exit $fail

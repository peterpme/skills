#!/usr/bin/env bash
# Offline cases for the hand-written line count in bin/pr-status: prints expected next to
# actual for each case and exits 1 if any disagrees.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
python3 -I - "$here/../../bin/pr-status" <<'PY'
import importlib.machinery, importlib.util, sys
loader = importlib.machinery.SourceFileLoader("pr_status", sys.argv[1])
spec = importlib.util.spec_from_loader("pr_status", loader)
m = importlib.util.module_from_spec(spec)
loader.exec_module(m)

f = lambda name, a, d=0: {"filename": name, "additions": a, "deletions": d}
attrs = m.generated_patterns("docs/api/* linguist-generated=true\n*.txt text\n")
cases = [
    ("small hand-written PR", [f("bin/x", 20, 4)], "", (24, False)),
    ("lockfile only", [f("package-lock.json", 5000, 100), f("sub/yarn.lock", 300)], "", (0, False)),
    ("generated only (gitattributes)", [f("docs/api/a.md", 900)], "", (0, False)),
    ("lockfile ignored, code counted", [f("pnpm-lock.yaml", 9000), f("src/a.ts", 150, 50)], "", (200, False)),
    ("exactly at the cap", [f("a", 400)], "", (400, False)),
    ("one over the cap", [f("a", 300, 101)], "", (401, True)),
    ("over, Unsplittable: line", [f("a", 457)], "why\nUnsplittable: one generated move", (457, False)),
    ("over, empty Unsplittable:", [f("a", 457)], "Unsplittable:", (457, True)),
]
bad = 0
print(f"{'case':<34} {'expect':<12} {'actual':<12} ok")
for name, files, body, expect in cases:
    lines, over, _ = m.size_verdict(files, body, attrs)
    ok = (lines, over) == expect
    bad += not ok
    print(f"{name:<34} {str(expect):<12} {str((lines, over)):<12} {'yes' if ok else 'NO'}")
sys.exit(1 if bad else 0)
PY

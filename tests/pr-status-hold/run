#!/usr/bin/env bash
# Runs bin/pr-status against a fake `gh` (canned PR, threads and ticket JSON) to
# check the ready hold and exact-head review gate. Exits 1 on a mismatch.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
tool=$here/../../bin/pr-status
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/bin"
cat >"$work/bin/gh" <<'EOF'
#!/usr/bin/env bash
# Fake gh. $FIX/pr.json, $FIX/ticket.json hold the canned answers.
args="$*"
case $args in
  "api graphql"*) echo "{\"data\":{\"repository\":{\"pullRequest\":{\"reviewThreads\":{\"nodes\":${THREADS:-[]}}}}}}" ;;
  "api --paginate --slurp "*"/reviews") cat "$FIX/reviews.json" ;;
  "api --paginate --slurp "*"/comments") cat "$FIX/comments.json" ;;
  "pr view"*) cat "$FIX/pr.json" ;;
  "issue view"*) cat "$FIX/ticket.json" ;;
  *) echo "fake gh: unexpected $args" >&2; exit 1 ;;
esac
EOF
chmod +x "$work/bin/gh"
fail=0
now=2026-11-10T12:00:00Z
case_() { # name expect_exit expect_text draft body ticket_json
  local name=$1 exp=$2 text=$3 draft=$4 body=$5 ticket=$6 out code ok=yes
  export FIX=$work/$name; mkdir -p "$FIX"
  jq -cn --argjson d "$draft" --arg b "$body" --arg m "${MERGEABLE:-MERGEABLE}" --arg s "${MSTATE:-CLEAN}" '{number: 5, title: "t", body: $b, url: "https://github.com/peterpme/skills/pull/5", state: "OPEN", isDraft: $d, mergeable: $m, mergeStateStatus: $s, reviewDecision: null, baseRefName: "main", headRefName: "b", headRefOid: "0123456789abcdef", statusCheckRollup: []}' >"$FIX/pr.json"
  printf '%s' "$ticket" >"$FIX/ticket.json"
  out=$(PATH="$work/bin:$PATH" PR_STATUS_NOW=$now "$tool" 5 -R peterpme/skills 2>&1); code=$?
  [[ $code == "$exp" ]] || ok=NO
  [[ -z $text ]] || grep -q -- "$text" <<<"$out" || ok=NO
  [[ $ok == yes ]] || fail=1
  printf '%-44s expect %s %-12s actual %s %s\n' "$name" "$exp" "${text:+HOLD}" "$code" "$ok"
  [[ $ok == yes ]] || echo "$out" | sed 's/^/    /'
}
contract='{"createdAt":"2026-11-10T11:00:00Z","body":"Contract\n## Verification\n1. x\n## Validation\nflow"}'
old_contract='{"createdAt":"2026-11-10T09:00:00Z","body":"Contract\n## Verification\n1. x\n## Validation\nflow"}'
chatter='{"createdAt":"2026-11-10T11:30:00Z","body":"claim #1"}'
printf '%-44s\n' case
case_ "tier-2 contract 1h old, draft" 9 "stays a draft until 2026-11-10 13:00Z" true "Part of peterpme/home#105" "{\"body\":\"Tier: 2\",\"labels\":[],\"comments\":[$chatter,$contract]}"
case_ "tier-2 contract 3h old, draft" 0 "" true "Part of peterpme/home#105" "{\"body\":\"Tier: 2\",\"labels\":[],\"comments\":[$old_contract]}"
case_ "tier-2 by label, no contract comment" 9 "no contract comment" true "Closes #7" '{"body":"x","labels":[{"name":"tier-2"}],"comments":[]}'
case_ "tier-1 ticket, contract 1h old" 0 "" true "Part of peterpme/home#105" "{\"body\":\"Tier 1 work\",\"labels\":[],\"comments\":[$contract]}"
case_ "ticket only discusses tier 2 in a table" 0 "" true "Part of peterpme/home#105" "{\"body\":\"| Tier 2 PR stays a draft | pr-status |\",\"labels\":[],\"comments\":[$contract]}"
case_ "tier-2, contract 1h old, already ready" 0 "" false "Part of peterpme/home#105" "{\"body\":\"Tier: 2\",\"labels\":[],\"comments\":[$contract]}"
case_ "PR body names no ticket" 0 "" true "Just a change" '{}'
MERGEABLE=CONFLICTING MSTATE=DIRTY case_ "merge conflict, checks green" 10 "merge conflict" false "Just a change" "{}"
THREADS='[{"isResolved":false,"isOutdated":false}]' case_ "one unresolved review thread" 11 "unresolved review thread" false "Just a change" "{}"

review_case() { # name expected reviews comments
  local name=$1 exp=$2 reviews=$3 comments=$4 out code ok=yes
  export FIX=$work/$name; mkdir -p "$FIX"
  printf '%s\n' '{"number":5,"headRefOid":"abc","author":{"login":"author"}}' >"$FIX/pr.json"
  printf '%s\n' "$reviews" >"$FIX/reviews.json"
  printf '%s\n' "$comments" >"$FIX/comments.json"
  out=$(PATH="$work/bin:$PATH" "$tool" --reviewed 5 -R peterpme/skills 2>&1); code=$?
  [[ $code == "$exp" ]] || { ok=NO; fail=1; }
  printf '%-44s expect %-14s actual %s %s\n' "$name" "$exp" "$code" "$ok"
  [[ $ok == yes ]] || echo "$out" | sed 's/^/    /'
}
review_case "reviewer reviewed current head" 0 '[[],[{"commit_id":"abc","state":"COMMENTED","user":{"login":"reviewer"}}]]' '[]'
review_case "bot commented on current head" 0 '[]' '[[{"original_commit_id":"abc","commit_id":"abc","user":{"login":"bot[bot]"}}]]'
review_case "reviewed old head" 12 '[[{"commit_id":"old","state":"APPROVED","user":{"login":"reviewer"}}]]' '[[{"original_commit_id":"old","commit_id":"abc","user":{"login":"reviewer"}}]]'
review_case "PR author reviewed current head" 12 '[[{"commit_id":"abc","state":"COMMENTED","user":{"login":"Author"}}]]' '[[{"original_commit_id":"abc","user":{"login":"author"}}]]'
review_case "reviewer has an unpublished draft" 12 '[[{"id":9,"commit_id":"abc","state":"PENDING","user":{"login":"reviewer"}}]]' '[[{"pull_request_review_id":9,"original_commit_id":"abc","user":{"login":"reviewer"}}]]'
review_case "current head has no review" 12 '[]' '[]'
exit $fail

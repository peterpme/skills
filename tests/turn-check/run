#!/usr/bin/env bash
# Runs bin/turn-check on every case in cases/*.json and prints expected next to
# actual. A case is {"expect":"block"|"allow","input":{...Stop hook input...}},
# {"expect":[...],"inputs":[...]} for a sequence sharing one state dir, or
# {"expect":..., "raw":"<stdin as is>"}. Each case gets a fresh state dir.
# Exits 1 if any case disagrees.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
hook=$here/../../bin/turn-check
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
fail=0
run_one() { # stdin -> "block|allow|exit N<TAB>reason"
  local out code
  out=$("$hook"); code=$?
  if ((code != 0)); then printf 'exit %s\t\n' "$code"
  elif [[ -z $out ]]; then printf 'allow\t\n'
  else jq -r '"\(.decision // "bad")\t\(.reason // "" | .[:90])"' <<<"$out" 2>/dev/null || printf 'bad\t\n'
  fi
}
printf '%-32s %-6s %-6s %-4s %s\n' case expect actual ok reason
for f in "$here"/cases/*.json; do
  name=$(basename "$f" .json)
  export TURN_CHECK_STATE=$work/$name
  n=$(jq -r 'if has("inputs") then (.inputs|length) else 1 end' "$f")
  for ((i = 0; i < n; i++)); do
    expect=$(jq -r --argjson i "$i" 'if (.expect|type)=="array" then .expect[$i] else .expect end' "$f")
    if jq -e 'has("raw")' "$f" >/dev/null; then line=$(jq -rj .raw "$f" | run_one)
    elif jq -e 'has("inputs")' "$f" >/dev/null; then line=$(jq -c --argjson i "$i" '.inputs[$i]' "$f" | run_one)
    else line=$(jq -c .input "$f" | run_one)
    fi
    actual=${line%%$'\t'*}; reason=${line#*$'\t'}
    ok=yes; [[ $expect == "$actual" ]] || { ok=NO; fail=1; }
    label=$name; ((n > 1)) && label="$name[$((i + 1))]"
    printf '%-32s %-6s %-6s %-4s %s\n' "$label" "$expect" "$actual" "$ok" "$reason"
  done
done
exit $fail

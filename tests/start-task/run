#!/usr/bin/env bash
# Runs bin/start-task against a fake home README (work folder /w/acme) and
# prints expected next to actual per case. Each case: a name, the cwd, how it
# is called (cli, hook, off, nohome), and a pattern the output must match plus
# one it must not. Exits 1 if any case disagrees.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
hook=$here/../../bin/start-task
bash -n "$hook" || { echo "start-task does not parse"; exit 1; }
/bin/bash -n "$hook" 2>/dev/null || { echo "start-task does not parse under /bin/bash"; exit 1; }
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/home" "$work/w/acme/wallet" "$work/w/acme/x" "$work/w/acme-old" "$work/u/skills"
echo 'Rule: under `'"$work"'/w/acme` the tracker is Linear; everywhere else it is this repo'"'"'s issues.' >"$work/home/README.md"
mkdir -p "$work/tilde"; echo 'Rule: under `~/w/acme` the tracker is Linear.' >"$work/tilde/README.md"
fail=0
# name ;; cwd under the temp dir ;; mode ;; must match (ERE) ;; must not match (ERE, empty = none)
cases=(
  'work-folder;;/w/acme/wallet;;cli;;tracker is Linear.*linear-mirror;;peterpme/home issues[.]'
  'work-folder-root;;/w/acme;;cli;;tracker is Linear;;is personal'
  'personal;;/u/skills;;cli;;is personal: the tracker is peterpme/home issues.*gh issue list -R peterpme/home --state all --search;;Linear'
  'prefix-sibling;;/w/acme-old;;cli;;is personal;;tracker is Linear'
  'tiers-printed;;/u/skills;;cli;;[|] 1 [|] Feature.*[|] 2 [|] Money;;'
  'no-home;;/w/acme/wallet;;nohome;;is personal.*Work folder unknown;;tracker is Linear'
  'hook-json;;/w/acme/x;;hook;;^[{]"hookSpecificOutput":[{]"hookEventName":"SessionStart","additionalContext":"start-task: .*tracker is Linear;;'
  'tilde-path;;/w/acme/wallet;;tilde;;tracker is Linear;;is personal'
  'open-stdin;;/u/skills;;openpipe;;is personal;;'
  'off;;/w/acme;;off;;^$;;'
)
printf '%-18s %-6s %s\n' case exit ok
for c in "${cases[@]}"; do
  IFS=$'\x1f' read -r name cwd mode want avoid <<<"${c//;;/$'\x1f'}"
  cwd=$work$cwd
  case $mode in
    cli) out=$(cd "$cwd" && START_TASK_HOME=$work/home "$hook" </dev/null); code=$? ;;
    nohome) out=$(cd "$cwd" && START_TASK_HOME=$work/missing "$hook" </dev/null); code=$? ;;
    tilde) out=$(cd "$cwd" && HOME=$work START_TASK_HOME=$work/tilde "$hook" </dev/null); code=$? ;;
    openpipe) # stdin held open with no data, as an agent shell does: must not hang
      start=$SECONDS; out=$(cd "$cwd" && START_TASK_HOME=$work/home "$hook" < <(sleep 8)); code=$?
      ((SECONDS - start < 6)) || code=hung ;;
    off) out=$(cd "$cwd" && START_TASK_OFF=1 START_TASK_HOME=$work/home "$hook" </dev/null); code=$? ;;
    hook) out=$(jq -cn --arg c "$cwd" '{session_id:"t",hook_event_name:"SessionStart",source:"startup",cwd:$c}' | START_TASK_HOME=$work/home "$hook"); code=$?
      jq -e '.hookSpecificOutput.additionalContext | type == "string"' >/dev/null 2>&1 <<<"$out" || code=json ;;
  esac
  flat=$(printf '%s' "$out" | tr '\n' ' ')
  ok=yes
  [[ $code == 0 ]] || ok=NO
  grep -Eq -- "$want" <<<"$flat" || ok=NO
  [[ -n $avoid ]] && grep -Eq -- "$avoid" <<<"$flat" && ok=NO
  [[ $mode == off && -n $out ]] && ok=NO
  [[ $ok == yes ]] || fail=1
  printf '%-18s %-6s %s\n' "$name" "$code" "$ok"
done

# The edit gate (PreToolUse). Each case: name ;; tool ;; transcript text ("-" = no file) ;; expected
# verdict per call ("deny,none" = first call denied, second allowed from the session state) ;;
# the Bash command, if any.
nolink='{"type":"user","message":{"role":"user","content":"Fix sum.sh"}}'
# A search that returned the ticket's URL, and the SessionStart text naming gh issue create: neither is a write.
searched='{"type":"user","message":{"role":"user","content":"Fix sum.sh"}}
{"type":"attachment","attachment":{"type":"hook_additional_context","content":["Create: gh issue create -R peterpme/home"]}}
{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Bash","input":{"command":"gh issue list -R peterpme/home --search sum --json url"}}]}}
{"type":"user","message":{"content":[{"type":"tool_result","content":"[{\"url\":\"https://github.com/peterpme/home/issues/42\"}]"}]}}'
wrote='{"type":"user","message":{"role":"user","content":"Fix sum.sh"}}
{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Bash","input":{"command":"gh issue comment 42 -R peterpme/home --body-file b.md"}}]}}'
gates=(
  "gate-no-ticket-once;;Edit;;nolink;;deny,none"
  "gate-search-only;;Edit;;searched;;deny,none"
  "gate-gh-comment;;Write;;wrote;;none"
  "gate-linear-tool;;Edit;;lineartool;;none"
  "gate-home-ref-prompt;;Edit;;ref;;none"
  "gate-linear-url-prompt;;MultiEdit;;linear;;none"
  "gate-read-tool;;Read;;nolink;;none"
  "gate-bash-read;;Bash;;nolink;;none;;cat sum.sh; sed -n 1,5p sum.sh 2>&1 >/dev/null"
  "gate-bash-sed-i;;Bash;;nolink;;deny,none;;sed -i 's/1/0/' sum.sh && ./sum.sh 2 3"
  "gate-bash-cat-heredoc;;Bash;;nolink;;deny;;cat > sum.sh <<'EOF'"
  "gate-bash-perl-i;;Bash;;nolink;;deny;;perl -pi -e 's/1/0/' sum.sh"
  "gate-bash-ticket-body;;Bash;;nolink;;none;;cat > body.md <<'EOF' && gh issue create -R peterpme/home --body-file body.md"
  "gate-bash-verification;;Bash;;nolink;;none;;mkdir -p .verification/x && cat > .verification/x/notes.md"
  "gate-bash-after-write;;Bash;;wrote;;none;;sed -i 's/1/0/' sum.sh"
  "gate-no-transcript;;Edit;;-;;none"
  "gate-off;;Edit;;nolink-off;;none"
)
verdict() { # stdin hook output -> deny|none|bad
  local out; out=$(cat)
  if [[ -z $out ]]; then echo none
  else jq -r '.hookSpecificOutput | select(.hookEventName == "PreToolUse") | .permissionDecision // "bad"' <<<"$out" 2>/dev/null || echo bad
  fi
}
for g in "${gates[@]}"; do
  IFS=$'\x1f' read -r name tool kind expects cmd <<<"${g//;;/$'\x1f'}"
  d=$work/gate/$name; mkdir -p "$d"
  t=$d/session.jsonl
  case $kind in
    nolink | nolink-off) printf '%s\n' "$nolink" >"$t" ;;
    searched) printf '%s\n' "$searched" >"$t" ;;
    wrote) printf '%s\n' "$wrote" >"$t" ;;
    lineartool) printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"mcp__linear-server__save_issue","input":{"title":"x"}}]}}' >"$t" ;;
    ref) printf '%s\n' '{"type":"user","message":{"content":"Continue peterpme/home#17"}}' >"$t" ;;
    linear) printf '%s\n' '{"type":"user","message":{"content":"https://linear.app/acme/issue/MOB-12/x"}}' >"$t" ;;
    -) t=$d/missing.jsonl ;;
  esac
  input=$(jq -cn --arg t "$t" --arg tool "$tool" --arg s "$name" --arg c "$cmd" '{session_id:$s,transcript_path:$t,hook_event_name:"PreToolUse",tool_name:$tool,tool_input:(if $c == "" then {file_path:"/x"} else {command:$c} end),cwd:"/"}')
  IFS=, read -ra want <<<"$expects"
  for i in "${!want[@]}"; do
    if [[ $kind == nolink-off ]]; then out=$(START_TASK_OFF=1 START_TASK_STATE=$d/state "$hook" <<<"$input"); code=$?
    else out=$(START_TASK_STATE=$d/state "$hook" <<<"$input"); code=$?
    fi
    actual=$(verdict <<<"$out"); ((code == 0)) || actual="exit $code"
    ok=yes; [[ $actual == "${want[$i]}" ]] || { ok=NO; fail=1; }
    printf '%-24s %-6s %-6s %s\n' "$name[$((i + 1))]" "${want[$i]}" "$actual" "$ok"
  done
done
exit $fail

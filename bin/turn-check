#!/usr/bin/env bash
# turn-check: Claude Code Stop hook. Sends the agent back once when it tries to
# end a turn with a background task still running, or with a promise to report
# later that nothing will wake it for. Reads the Stop hook input on stdin and
# prints {"decision":"block","reason":...} to block, nothing to allow. Always
# exits 0, so a broken hook never costs a turn. Each task blocks once per
# session (state in ~/.local/state/turn-check, or $TURN_CHECK_STATE), so a dev
# server that stays up does not block every turn. scripts/sync-skills.mjs
# registers it in each ~/.claude*/settings.json; tests/turn-check/run checks it.
set -uo pipefail
case ${1:-} in -h | --help) sed -n '2,9p' "$0" | cut -c3-; exit 0 ;; esac
command -v jq >/dev/null 2>&1 || PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
command -v jq >/dev/null 2>&1 || exit 0
input=$(cat 2>/dev/null) || exit 0
[[ -n $input ]] || exit 0
jq -e 'type == "object"' >/dev/null 2>&1 <<<"$input" || exit 0

state=${TURN_CHECK_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/turn-check}
# Without a session id, fall back to the harness process: hooks run as children of it.
session=$(jq -r '.session_id // "" | tostring | gsub("[^A-Za-z0-9_-]"; "_")' <<<"$input" 2>/dev/null)
[[ -n $session ]] || session=pid$PPID
seen=$state/$session
mkdir -p "$state" 2>/dev/null && find "$state" -type f -mtime +7 -delete 2>/dev/null
[[ -f $seen ]] || : >"$seen" 2>/dev/null
seenjson=$(jq -R . "$seen" 2>/dev/null | jq -s . 2>/dev/null) || seenjson='[]'

# A delegate_task child started since the user's last message wakes this thread when it
# finishes, so a promise to relay its result has its wake. Read from the transcript.
delegated=false
transcript=$(jq -r '.transcript_path // "" | tostring' <<<"$input" 2>/dev/null)
if [[ -n $transcript && -f $transcript ]]; then
  delegated=$(tail -n 400 "$transcript" 2>/dev/null | jq -s '
    map(select(.type == "user" or .type == "assistant"))
    | (map(.type == "user" and ((.message.content | type) == "string"
        or ((.message.content | type) == "array" and any(.message.content[]; .type == "text")))) | rindex(true) // -1) as $u
    | .[$u + 1:]
    | any(.[]; .type == "assistant" and ((.message.content | type) == "array")
        and any(.message.content[]; .type == "tool_use" and ((.name // "") | test("delegate_task$"))))' 2>/dev/null) || delegated=false
  [[ $delegated == true ]] || delegated=false
fi

out=$(jq -c --argjson seen "$seenjson" --argjson delegated "$delegated" '
  # A promise to report later: "I will check the files once it finishes",
  # "when it finishes, I will send the counts", "will report back when done".
  # A sentence runs to a period followed by space or end, so file names pass;
  # "when you ..." waits on the user, whose reply is the wake.
  def sentence: "(?:[^.\\n]|\\.(?=\\S)){0,80}";
  # Quoted and code spans are not this agent speaking (a README line that quotes a promise).
  def unquoted: gsub("`[^`\\n]*`"; " ") | gsub("\"[^\"\\n]*\""; " ");
  def promise: unquoted |
    [ match("\\b(I.ll|I will)\\s+(report|check|follow up|update you|let you know|come back|get back|post|reply|send|ping|notify|watch|monitor|keep (an eye|watching|monitoring))\\b" + sentence + "\\b(when|once|after|as soon as|later)\\b(?!\\s+you\\b)"; "i"),
      match("\\b(when|once|after)\\b(?!\\s+you\\b)" + sentence + "\\b(finish|finishes|finished|complete|completes|completed|is done|done)\\b" + sentence + "\\b(I.ll|I will)\\b(?!\\s+need\\b)"; "i"),
      match("\\b(I.ll|I will|will) (report|check|circle|get) back\\b"; "i"),
      match("\\b(I.ll|I will)\\b(?!\\s+need\\b)" + sentence + "\\b(when|once|after|as soon as)\\b(?!\\s+you\\b)" + sentence + "\\b(finish|finishes|finished|complet\\w*|done|ready)\\b"; "i"),
      match("\\b(I.ll|I will)\\b" + sentence + "\\bin (about |roughly |around |~)?\\d+ ?(seconds|minutes|min|hours|h)\\b"; "i"),
      match("\\b(results?|numbers|output|counts|report|summary) will (follow|land|arrive|be ready|be posted)\\b" + sentence + "\\b(when|once|after|as soon as)\\b(?!\\s+you\\b)"; "i") ]
    | .[0].string;
  def live: select(((.status // "running") | ascii_downcase | test("complet|done|finish|fail|error|kill|cancel|stopp|timed|timeout")) | not);
  def describe: "\(.type // "task") \(.id // "?")" + (if (.command // .description) then " `\((.command // .description)[:100])`" else "" end);
  if .hook_event_name != "Stop" or .stop_hook_active == true then empty
  else
    ([.background_tasks[]? | live]) as $running
    | ($running | map(select((.id // "?" | tostring) as $id | $seen | index($id) | not))) as $tasks
    | if ($tasks | length) > 0 then
        {decision: "block",
         ids: ($tasks | map(.id // "?" | tostring)),
         reason: ("turn-check: \($tasks | length) background task(s) still running: \($tasks | map(describe) | join("; ")). A harness background command dies with the session, and in a scheduled or T3 run the session ends with this turn. Wait for it inside the turn (t3_background_wait, Monitor, or `bgjob wait NAME`) and report the result, or restart it under `bgjob start NAME -- <cmd>` and tell the user how to check it. If it is meant to stay up (a dev server) or something will truly wake you, say so and stop again; this task will not block again.")}
      elif ((.session_crons // []) | length) > 0 then empty
      elif $delegated then empty
      else
        ((.last_assistant_message // "") | promise) as $m
        | if $m then
            {decision: "block",
             reason: ("turn-check: the final message promises a later report (\"\($m)\") but nothing will wake you: " + (if ($running | length) > 0 then "the running task was already flagged once" else "no background task is registered" end) + " and no wakeup is scheduled. Finish the job in this turn (`bgjob wait NAME`), or replace the promise with what the user runs to check (`bgjob status NAME`). If you cannot wait, say so plainly and stop again.")}
          else empty end
      end
  end' <<<"$input" 2>/dev/null) || exit 0
[[ -n $out ]] || exit 0
jq -r '.ids[]? // empty' <<<"$out" >>"$seen" 2>/dev/null
jq -c 'del(.ids)' <<<"$out"
exit 0

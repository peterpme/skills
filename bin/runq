#!/usr/bin/env bash
# runq [-n LINES] [--] COMMAND [ARGS...]
#
# Run a noisy command quietly: save its full output to a log, then print the
# exit code, duration, log path and only the last LINES lines (default 20).
# Exits with the command's own exit code. Logs go to <git root>/.verification/runq/
# (or ~/.local/state/runq outside a repo). Example: runq yarn tsc --noEmit
set -uo pipefail

lines=20
while (($#)); do
  case $1 in
    -n) lines=$2; shift 2 ;;
    -h | --help) sed -n '2,8p' "$0" | cut -c3-; exit 0 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
(($#)) || { echo "runq: no command given" >&2; exit 2; }

if root=$(git rev-parse --show-toplevel 2>/dev/null); then
  dir=$root/.verification/runq
else
  dir=$HOME/.local/state/runq
fi
mkdir -p "$dir"
slug=$(printf '%s' "$*" | tr -cs 'A-Za-z0-9._-' '-' | cut -c1-48)
log=$dir/$(date +%Y%m%d-%H%M%S)-${slug%-}.log

start=$SECONDS
"$@" >"$log" 2>&1
code=$?
total=$(wc -l <"$log" | tr -d ' ')
echo "exit=$code  time=$((SECONDS - start))s  lines=$total  log=$log"
if ((total > lines)); then echo "... last $lines lines:"; fi
tail -n "$lines" "$log" | cut -c1-400
exit "$code"

#!/usr/bin/env bash
# scheduled-models [--db FILE]
# Lists the T3 scheduled tasks and flags each enabled one whose model breaks the
# models.tsv scheduled-worker row (home#105): any task on Fable, Grok or an opencode model
# ("No scheduled task runs Fable"), and the Worker task if it is not
# claudeAgent / claude-opus-5-5 / effort high. Reads only the title, enabled
# flag and model selection from T3's database (read-only; the task prompts and
# webhook secrets in that table are never selected). Exit 1 if any enabled task
# is flagged, 0 otherwise, including on a machine with no T3 database.
# The chief-of-staff skill runs it daily. Database: $T3_STATE_DB, else
# ~/.t3/userdata/statev2.sqlite.
set -uo pipefail
case ${1:-} in -h | --help) sed -n '2,11p' "$0" | cut -c3-; exit 0 ;; esac
db=${T3_STATE_DB:-$HOME/.t3/userdata/statev2.sqlite}
[[ ${1:-} == --db ]] && db=${2:?--db needs a file}
command -v sqlite3 >/dev/null 2>&1 || { echo "scheduled-models: sqlite3 not installed"; exit 0; }
command -v jq >/dev/null 2>&1 || PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
command -v jq >/dev/null 2>&1 || { echo "scheduled-models: jq not installed"; exit 0; }
[[ -r $db ]] || { echo "scheduled-models: no T3 database at $db, nothing to check"; exit 0; }
rows=$(sqlite3 -readonly -json "$db" "select title, enabled, model_selection_json as sel from scheduled_tasks order by enabled desc, title" 2>&1) || { echo "scheduled-models: cannot read $db: $rows"; exit 1; }
[[ -n $rows ]] || rows='[]'
result=$(jq '
  def eff: ((.options // []) | if type == "array" then (map(select(.id == "effort") | .value) | first) else (.effort // null) end) // "-";
  map(. as $t | ($t.sel | fromjson) as $s
    | ($s.model // "?") as $m | ($s.instanceId // "?") as $i | ($s | eff) as $e
    | {title: $t.title, on: ($t.enabled == 1), instance: $i, model: $m, effort: $e,
       flag: (if ($m + " " + $i) | test("fable|grok|opencode|cursor|antigravity|gemini"; "i") then "FORBIDDEN: scheduled tasks run Claude (not Fable) or gpt-6.1-sol on codex; never Fable, Grok, Cursor or opencode"
              elif ($t.title | test("^Worker")) and ($i != "claudeAgent" or $m != "claude-opus-5-5" or $e != "high") then "DRIFT: the table says Worker is claudeAgent / claude-opus-5-5 / high"
              else "" end)})' <<<"$rows") || { echo "scheduled-models: unexpected model data in $db"; exit 1; }
jq -r '.[] | "\(if .on then "on " else "off" end)  \(.title)  [\(.instance) \(.model) \(.effort)]\(if .flag != "" then "  <- " + .flag else "" end)"' <<<"$result"
flagged=$(jq '[.[] | select(.on and .flag != "")] | length' <<<"$result")
echo "scheduled-models: $(jq length <<<"$result") tasks, $flagged enabled and flagged"
((flagged == 0))

#!/usr/bin/env python3
"""pr-status [PR] [-R owner/repo] [--json]

One compact view of a pull request: state, draft, mergeability, review
decision, head commit, CI counts with only the non-passing checks listed, and
and the number of unresolved review threads. PR defaults to the current
branch's. Exit 1 when a check failed, 8 while checks are pending, 9 when a
draft PR's ticket is tier 2 and its contract is
under two hours old or missing (a tier 2 PR stays a draft until then, home#105),
else 0.
"""
import argparse
import datetime
import json
import os
import re
import subprocess
import sys
import time

FIELDS = "number,title,url,body,state,isDraft,mergeable,mergeStateStatus,reviewDecision,baseRefName,headRefName,headRefOid,statusCheckRollup"
PASS = {"SUCCESS", "NEUTRAL"}
SKIP = {"SKIPPED"}
FAIL = {"FAILURE", "ERROR", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE", "STALE"}



def gh(*args):
    result = subprocess.run(["gh", *args], capture_output=True, text=True)
    if result.returncode != 0:
        sys.exit(result.stderr.strip() or f"gh {' '.join(args)} failed")
    return result.stdout


def check_rows(rollup):
    # A re-run or second trigger lists the same check twice; keep the newest.
    latest = {}
    for c in rollup or []:
        key = (c.get("__typename"), c.get("workflowName"), c.get("name") or c.get("context"))
        when = c.get("startedAt") or c.get("completedAt") or ""
        if key not in latest or when >= (latest[key].get("startedAt") or latest[key].get("completedAt") or ""):
            latest[key] = c
    rows = []
    for c in latest.values():
        if c.get("__typename") == "StatusContext":
            name, state, url = c.get("context"), c.get("state") or "PENDING", c.get("targetUrl")
        else:
            name = c.get("name")
            if c.get("workflowName") and c.get("workflowName") != name:
                name = f"{c['workflowName']} / {name}"
            state = c.get("conclusion") or c.get("status") or "PENDING"
            url = c.get("detailsUrl")
        bucket = "pass" if state in PASS else "skipped" if state in SKIP else "fail" if state in FAIL else "pending"
        rows.append((bucket, state, name, url or ""))
    return rows



def unresolved_threads(repo, number):
    owner, name = repo.split("/", 1)
    query = """query($owner:String!,$name:String!,$number:Int!){repository(owner:$owner,name:$name){
      pullRequest(number:$number){reviewThreads(first:100){nodes{isResolved isOutdated}}}}}"""
    out = gh("api", "graphql", "-f", f"query={query}", "-F", f"owner={owner}", "-F", f"name={name}", "-F", f"number={number}")
    nodes = json.loads(out)["data"]["repository"]["pullRequest"]["reviewThreads"]["nodes"]
    return sum(1 for n in nodes if not n["isResolved"])


TIER2 = re.compile(r"(^[\s>*_#-]*tier\b[\s:*_-]*2\b)|(\btier\s*[:=]\s*2\b)", re.I | re.M)
TICKET = re.compile(r"\b(?:closes|fixes|resolves|refs?|part of|ticket)\s*:?\s*(?:([\w.-]+/[\w.-]+)#|(home)#|#)(\d+)", re.I)
HOLD_HOURS = 2


def parse_time(text):
    return datetime.datetime.fromisoformat(text.replace("Z", "+00:00"))


def ready_hold(repo, body, now):
    """Why a tier 2 draft may not leave draft yet, or None. The tier is a `Tier: 2` /
    `Tier 2` line or `tier-2` label on the ticket the PR body names; the contract is the
    first ticket comment that holds both a Verification and a Validation block."""
    m = TICKET.search(body or "")
    if not m:
        return None
    ticket_repo = m.group(1) or ("peterpme/home" if m.group(2) else repo)
    out = subprocess.run(["gh", "issue", "view", m.group(3), "-R", ticket_repo, "--json", "body,labels,comments"], capture_output=True, text=True)
    if out.returncode != 0:
        return None
    ticket = json.loads(out.stdout)
    texts = [ticket.get("body") or ""] + [c.get("body") or "" for c in ticket.get("comments", [])]
    labelled = any(re.fullmatch(r"tier[\s-]*2", l["name"], re.I) for l in ticket.get("labels", []))
    if not labelled and not any(TIER2.search(t) for t in texts):
        return None
    name = f"{ticket_repo}#{m.group(3)}"
    contract = next((c for c in ticket.get("comments", []) if re.search(r"verification", c.get("body") or "", re.I) and re.search(r"validation", c.get("body") or "", re.I)), None)
    if not contract:
        return f"{name} is tier 2 and has no contract comment (Verification and Validation blocks) yet"
    ready_at = parse_time(contract["createdAt"]) + datetime.timedelta(hours=HOLD_HOURS)
    if now < ready_at:
        return f"{name} is tier 2: stays a draft until {ready_at:%Y-%m-%d %H:%M}Z, {HOLD_HOURS} hours after its contract"
    return None


def main():
    parser = argparse.ArgumentParser(usage=__doc__.splitlines()[0], description=__doc__.split("\n", 2)[2])
    parser.add_argument("pr", nargs="?")
    parser.add_argument("-R", "--repo")
    parser.add_argument("--json", action="store_true", help="print the collected data as JSON")
    args = parser.parse_args()

    view = ["pr", "view", *([args.pr] if args.pr else []), "--json", FIELDS]
    if args.repo:
        view += ["-R", args.repo]
    pr = json.loads(gh(*view))
    if pr["mergeable"] == "UNKNOWN":  # GitHub computes this lazily; the first read often says UNKNOWN
        time.sleep(3)
        pr = json.loads(gh(*view))
    repo = args.repo or pr["url"].split("github.com/", 1)[1].rsplit("/pull/", 1)[0]
    rows = check_rows(pr.pop("statusCheckRollup"))
    counts = {b: sum(1 for r in rows if r[0] == b) for b in ("pass", "skipped", "fail", "pending")}
    threads = unresolved_threads(repo, pr["number"])
    # PR_STATUS_BODY replaces the fetched body (test fixture).
    fetched_body = pr.pop("body", None)
    body = os.environ.get("PR_STATUS_BODY", fetched_body)
    now = parse_time(os.environ["PR_STATUS_NOW"]) if os.environ.get("PR_STATUS_NOW") else datetime.datetime.now(datetime.timezone.utc)
    hold = ready_hold(repo, body, now) if pr["isDraft"] else None

    if args.json:
        print(json.dumps({**pr, "checks": counts, "unresolvedThreads": threads, "readyHold": hold,
                          "notPassing": [{"state": s, "name": n, "url": u} for b, s, n, u in rows if b in ("fail", "pending")]}))
    else:
        draft = " draft" if pr["isDraft"] else ""
        print(f"#{pr['number']} {pr['state']}{draft}  {pr['title']}")
        print(f"  {repo}  {pr['baseRefName']} <- {pr['headRefName']}@{pr['headRefOid'][:7]}")
        print(f"  mergeable={pr['mergeable']} ({pr['mergeStateStatus']})  review={pr['reviewDecision'] or 'NONE'}  unresolved threads={threads}")
        print(f"  checks: {counts['pass']} pass, {counts['fail']} fail, {counts['pending']} pending, {counts['skipped']} skipped")
        for bucket, state, name, url in sorted(r for r in rows if r[0] in ("fail", "pending")):
            print(f"    {state:<10} {name}  {url}")
        if hold:
            print(f"  ready: HOLD, {hold}")
    sys.exit(1 if counts["fail"] else 8 if counts["pending"] else 9 if hold else 0)


if __name__ == "__main__":
    main()
